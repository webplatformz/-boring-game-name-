{
  "name": "bundeshaus-pack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rip a Pack. Build the House. — a Swiss Parliament trading-card game.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-provenance.mjs && node scripts/check-privacy.mjs && node scripts/check-portrait-credits.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "data": "node scripts/fetch-raw.mjs && node scripts/build-members.mjs",
    "data:fetch": "node scripts/fetch-raw.mjs",
    "data:financing": "node scripts/import-efk-financing.mjs",
    "data:build": "node scripts/build-members.mjs",
    "simulate:battle": "node scripts/simulate-battle.mjs",
    "verify:debate": "node --experimental-strip-types --test unit-tests/*.test.ts",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:portraits": "node scripts/check-portrait-credits.mjs",
    "flags": "node scripts/fetch-flags.mjs",
    "portraits": "node scripts/fetch-portraits.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "data:all": "node scripts/fetch-flags.mjs && node scripts/fetch-portraits.mjs && node scripts/fetch-raw.mjs && node scripts/build-members.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.11"
  }
}
