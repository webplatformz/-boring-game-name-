{
  "name": "bundeshaus-pack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rip a Pack. Build the House. — a Swiss Parliament trading-card game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data": "node scripts/fetch-raw.mjs && node scripts/build-members.mjs",
    "data:fetch": "node scripts/fetch-raw.mjs",
    "data:build": "node scripts/build-members.mjs",
    "flags": "node scripts/fetch-flags.mjs",
    "portraits": "node scripts/fetch-portraits.mjs",
    "data:all": "node scripts/fetch-flags.mjs && node scripts/fetch-portraits.mjs && node scripts/fetch-raw.mjs && node scripts/build-members.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
